<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/navy"
            android:padding="25dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Donasi Form"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Form Fields -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <EditText
                android:id="@+id/etJudul"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Masukkan judul"
                android:inputType="text"
                android:textColor="@color/black"
                android:background="@drawable/bg_box"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>

            <EditText
                android:id="@+id/etDeskripsi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Masukkan deskripsi"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="6"
                android:gravity="top"
                android:textColor="@color/black"
                android:background="@drawable/bg_box"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_box"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvNamaGambar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Belum ada gambar dipilih"
                    android:padding="12dp"
                    android:textColor="@color/black"
                    />

                <Button
                    android:id="@+id/btnChooseFile"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Choose File"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/navy" />
            </LinearLayout>

            <EditText
                android:id="@+id/etNominalTarget"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Masukkan nominal target"
                android:inputType="number"
                android:textColor="@color/black"
                android:background="@drawable/bg_box"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"/>

            <EditText
                android:id="@+id/etNominalTerkumpul"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Masukkan nominal terkumpul"
                android:inputType="number"
                android:textColor="@color/black"
                android:background="@drawable/bg_box"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"/>

            <Spinner
                android:id="@+id/spinnerRoleUser"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:spinnerMode="dropdown"
                android:padding="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"/>

            <EditText
                android:id="@+id/etStatus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Status"
                android:inputType="text"
                android:textColor="@color/black"
                android:background="@drawable/bg_box"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"/>


            <Button
                android:id="@+id/btnTanggalBuka"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Pilih tanggal buka"
                android:backgroundTint="@color/navy"
                android:textColor="@android:color/white"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"/>


            <Button
                android:id="@+id/btnWaktuBuka"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Pilih waktu buka"
                android:backgroundTint="@color/navy"
                android:textColor="@android:color/white"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/btnTanggalTutup"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Pilih tanggal tutup"
                android:backgroundTint="@color/navy"
                android:textColor="@android:color/white"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/btnWaktuTutup"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Pilih waktu tutup"
                android:backgroundTint="@color/navy"
                android:textColor="@android:color/white"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"/>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CANCEL"
                    android:layout_marginEnd="16dp"
                    android:backgroundTint="@color/design_default_color_error"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAVE"
                    android:backgroundTint="@color/navy"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
