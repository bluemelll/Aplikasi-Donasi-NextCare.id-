<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".Donatur.DonaturHomeActivity">

    <LinearLayout
        android:id="@+id/profile_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/backgroundprofile"
        android:backgroundTint="@color/navy">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/namaUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Pengguna"
                android:textStyle="bold"
                android:textColor="@color/soft"
                android:textSize="18sp"
                android:ellipsize="end"
                android:maxLines="1"/>

            <TextView
                android:id="@+id/tglSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tanggal Bergabung"
                android:textColor="@color/soft"
                android:textSize="14sp"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imageProfile"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/person_icon"
            app:tint="@color/white"
            app:civ_border_color="@color/logo"
            app:civ_border_width="1dp"
            android:contentDescription="Profile Picture"
            android:layout_marginEnd="25dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="15dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/backgroundprofile"
            android:backgroundTint="@color/navy">

            <TextView
                android:id="@+id/saldo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SALDO"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:alpha="0.8"
                android:fontFamily="sans-serif-medium"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/saldoUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp0"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.01"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/soft">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:weightSum="3"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageButton
                            android:id="@+id/topupSaldo"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@color/navy"
                            android:src="@drawable/top_up_icon"
                            android:contentDescription="Top UP"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Top Up"
                            android:textColor="@color/navy"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageButton
                            android:id="@+id/donasiUser"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@color/navy"
                            android:src="@drawable/coin_icon"
                            android:contentDescription="Donasi"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Donasi"
                            android:textColor="@color/navy"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageButton
                            android:id="@+id/signOutUser"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@color/navy"
                            android:src="@drawable/logout_icon"
                            app:tint="@color/soft"
                            android:contentDescription="Sign Out Account"
                            android:scaleType="centerInside"
                            android:adjustViewBounds="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sign Out"
                            android:textColor="@color/navy"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        android:background="@drawable/backgroundprofile">

        <TextView
            android:id="@+id/textCampaign"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Campaign Terkini"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <ImageButton
            android:id="@+id/btnSeeAll"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/all_icon"
            android:background="@android:color/transparent"
            app:tint="@color/black"
            android:contentDescription="Lihat semua campaign" />
    </LinearLayout>

    <GridView
        android:id="@+id/gridViewDonasi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/backgroundprofile"
        android:gravity="center"
        android:horizontalSpacing="10dp"
        android:numColumns="2"
        android:padding="20dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:stretchMode="columnWidth"
        android:verticalSpacing="10dp" />
</LinearLayout>